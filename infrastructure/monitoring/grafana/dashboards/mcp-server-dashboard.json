{
  "dashboard": {
    "id": null,
    "panels": [
      {
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "targets": [
          {
            "expr": "up{job=\"mcp-server\"}",
            "legendFormat": "{{instance}}"
          }
        ],
        "title": "Server Uptime",
        "type": "stat"
      },
      {
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 6,
          "y": 0
        },
        "id": 2,
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"mcp-server\"}[5m])",
            "legendFormat": "{{method}} {{status}}"
          }
        ],
        "title": "Request Rate",
        "type": "graph",
        "yAxes": [
          {
            "label": "Requests/sec",
            "min": 0
          }
        ]
      },
      {
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "id": 3,
        "targets": [
          {
            "expr": "container_memory_usage_bytes{name=\"frontal-mcp-server\"} / 1024 / 1024",
            "legendFormat": "Memory (MB)"
          }
        ],
        "title": "Memory Usage",
        "type": "graph",
        "yAxes": [
          {
            "label": "Memory (MB)",
            "min": 0
          }
        ]
      },
      {
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "id": 4,
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{name=\"frontal-mcp-server\"}[5m]) * 100",
            "legendFormat": "CPU %"
          }
        ],
        "title": "CPU Usage",
        "type": "graph",
        "yAxes": [
          {
            "label": "CPU %",
            "max": 100,
            "min": 0
          }
        ]
      },
      {
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "id": 5,
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"mcp-server\"}[5m]))",
            "legendFormat": "95th percentile"
          },
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"mcp-server\"}[5m]))",
            "legendFormat": "50th percentile"
          }
        ],
        "title": "Response Time",
        "type": "graph",
        "yAxes": [
          {
            "label": "Response Time (s)",
            "min": 0
          }
        ]
      },
      {
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "id": 6,
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"mcp-server\",status=~\"5..\"}[5m]) / rate(http_requests_total{job=\"mcp-server\"}[5m]) * 100",
            "legendFormat": "Error Rate %"
          }
        ],
        "title": "Error Rate",
        "type": "graph",
        "yAxes": [
          {
            "label": "Error Rate %",
            "max": 100,
            "min": 0
          }
        ]
      },
      {
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 12,
          "y": 16
        },
        "id": 7,
        "targets": [
          {
            "expr": "http_connections_active{job=\"mcp-server\"}",
            "legendFormat": "Active Connections"
          }
        ],
        "title": "Active Connections",
        "type": "stat"
      },
      {
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 18,
          "y": 16
        },
        "id": 8,
        "targets": [
          {
            "expr": "kube_pod_info{namespace=\"mcp-server\"}",
            "format": "table",
            "instant": true
          }
        ],
        "title": "Pod Status",
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true
              },
              "indexByName": {},
              "renameByName": {
                "created_by_kind": "Created By",
                "node": "Node",
                "phase": "Phase",
                "pod": "Pod"
              }
            }
          }
        ],
        "type": "table"
      }
    ],
    "refresh": "30s",
    "tags": [
      "frontal",
      "mcp-server"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timezone": "browser",
    "title": "Frontal MCP Server Dashboard"
  }
}
