    200,
    206,
    301,
    302,
    401,
    403,
    429
  ],
  "fallbackRetryDelay": "30s",
  "ignorePatterns": [
    {
      "pattern": "^https?://localhost"
    },
    {
      "pattern": "^https?://127\\.0\\.0\\.1"
    },
    {
      "pattern": "^https?://\\[::1\\]"
    },
    {
      "pattern": "^mailto:"
    },
    {
      "pattern": "^https?://([a-zA-Z0-9-]+\\.)*frontal\\.(dev|cloud)"
    }
  ],
  "retryCount": 3,
  "retryOn429": true
}
