{
  "name": "@frontal-labs/mcp-server",
  "version": "1.0.3",
  "description": "Model Context Protocol server for Frontal",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "frontal-mcp-server": "dist/bin/frontal-mcp-server.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "openapi/public.v1.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && node -e \"const fs=require('fs');const f='dist/bin/frontal-mcp-server.js';let c=fs.readFileSync(f,'utf8');c=c.startsWith('#!')?c.replace(/^#!.*\\n/,'#!/usr/bin/env node\\n'):'#!/usr/bin/env node\\n'+c;fs.writeFileSync(f,c)\"",
    "build:watch": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint src/ tests/",
    "format": "biome format --write src/ tests/",
    "clean": "rm -rf dist",
    "sync-spec": "bun run scripts/sync-spec.ts",
    "sync-spec:check": "bun run scripts/sync-spec.ts --check",
    "dev": "bun run src/bin/frontal-mcp-server.ts",
    "prepublishOnly": "bun run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "git config --unset-all core.hooksPath 2>/dev/null; command -v pre-commit >/dev/null 2>&1 && pre-commit install >/dev/null 2>&1 || true"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "frontal",
    "frontal-labs",
    "ai",
    "serverless",
    "blob-storage",
    "functions",
    "typescript"
  ],
  "homepage": "https://github.com/frontal-labs/mcp-server",
  "bugs": "https://github.com/frontal-labs/mcp-server/issues",
  "license": "Apache-2.0",
  "author": "Frontal Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontal-labs/mcp-server.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.8"
  },
  "packageManager": "bun@1.3.8",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@t3-oss/env-core": "^0.13.11",
    "chalk": "^5.4.0",
    "commander": "^14.0.3",
    "ora": "^9.4.1",
    "tslib": "^2.8.1",
    "winston": "^3.11.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "pre-commit": "^2.0.0",
    "pre-commit-hooks": "^0.9.22",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "ultracite": "7.9.4",
    "vitest": "^4.1.10"
  }
}
