# Environment Configuration for Frontal MCP Server

# Frontal API key (frt_...). Used by the stdio transport. The HTTP transport is
# multi-tenant: it does NOT use this key and instead requires a per-request
# `Authorization: Bearer frt_...` header on every MCP call (missing token ->
# 401). The unauthenticated `GET /health` endpoint is the only exception.
FRONTAL_API_KEY=frt_your_api_key_here

# Optional: Frontal public API base URL. Bare host — versioned paths already
# include the `/v1/` prefix. Pin a region by using a regional host
# (https://us.api.frontal.dev) or the FRONTAL_REGION var below.
FRONTAL_BASE_URL=https://api.frontal.dev

# Optional: region pin, sent as the `x-frontal-region` header (e.g. iad, lhr,
# fra, sin). Unknown regions are rejected by the edge with HTTP 409.
# FRONTAL_REGION=iad

# Optional: comma-separated tool sets to register.
#   generic  -> spec-driven meta-tools (list/describe/call any endpoint)
#   ontology -> curated ontology / knowledge-graph tools
#   data     -> curated data-platform tools
FRONTAL_TOOLSETS=generic,ontology,data

# Optional: comma-separated browser origins allowed for CORS on the HTTP
# transport. Empty by default: no origin is trusted, so Access-Control-Allow-
# Origin is only echoed for a listed origin (never `*`). Non-browser callers
# are unaffected — they still authenticate with a per-request bearer token.
# FRONTAL_HTTP_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Optional: comma-separated hosts accepted in the `Host` header of MCP
# requests. Empty by default, which disables the check. Set this for any
# deployment reachable from a browser: it is what blocks DNS rebinding, where
# an attacker points a hostname they control at this server so a victim's
# browser treats the response as same-origin and CORS never applies. The
# unauthenticated `GET /health` endpoint is exempt so container and load
# balancer probes, which address the container directly, keep working.
# FRONTAL_HTTP_ALLOWED_HOSTS=mcp.frontal.dev,mcp.frontal.dev:443

# Optional: per-caller rate limiting, backed by Upstash Redis. Activates only
# when both the URL and token are set; otherwise the HTTP transport is
# unlimited. Callers are bucketed by a hash of their bearer token, so one
# tenant cannot spend another's budget. Over the limit returns HTTP 429 with
# `Retry-After` and `RateLimit-*` headers.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
# FRONTAL_RATE_LIMIT_REQUESTS=100
# FRONTAL_RATE_LIMIT_WINDOW=60 s
# FRONTAL_RATE_LIMIT_PREFIX=frontal-mcp
# How long to wait on Redis before letting the request through. A rate
# limiter outage should not become an outage of the whole server, so the
# request is allowed and a warning is logged.
# FRONTAL_RATE_LIMIT_TIMEOUT_MS=1000

# Optional: HTTP transport safety limits. The defaults suit the documented
# 512 MB deployment; raise them on a larger VM, lower them on a smaller one.
#   FRONTAL_HTTP_MAX_BODY_BYTES — largest request body accepted, in bytes.
#     Bodies are buffered before the session is known, so this bounds what one
#     caller can make the process allocate. Over the limit returns HTTP 413.
#   FRONTAL_HTTP_MAX_SESSIONS  — largest number of concurrent sessions. Each
#     session holds its own server instance (~0.6 MB). Past the limit new
#     sessions are refused with HTTP 503 while existing ones keep working.
# FRONTAL_HTTP_MAX_BODY_BYTES=4194304
# FRONTAL_HTTP_MAX_SESSIONS=256

# Optional: Server configuration
MCP_SERVER_PORT=3000
MCP_SERVER_HOST=localhost
MCP_LOG_LEVEL=info

# Optional: incident.io status page integration (auto-activates when API key is set)
# INCIDENTIO_API_KEY=inc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# INCIDENTIO_STATUS_PAGE_ID=01H0QJ1BXP0E76RGBYRDHKA2KQ
# INCIDENTIO_STATUS_PAGE_URL=https://frontal-status.com
# INCIDENTIO_COMPONENT_ID=01H0QJ1BXP0E76RGBYRDHKA2KB

# Optional: Authentication
AUTH_TYPE=api-key
# AUTH_TYPE=oauth

# Development
NODE_ENV=development
